{
    "name": "namvoy/namvoy",
    "description": "NamVoy - Vietnam travel booking platform (Phase 1: catalog marketplace)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-mysqli": "*",
        "ext-json": "*",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "migrate": "php bin/migrate.php",
        "lint": "find src public bin -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true
    }
}
